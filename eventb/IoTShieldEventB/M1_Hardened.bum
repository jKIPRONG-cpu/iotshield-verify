  <org.eventb.core.action name="_15" org.eventb.core.assignment="obs(d) ≔ min({obs(d) + 1, STH})" org.eventb.core.label="act3"/>
  <org.eventb.core.action name="_16" org.eventb.core.assignment="vol(d) ≔ min({vol(d) + 1, VMAX})" org.eventb.core.label="act4"/>
</org.eventb.core.event>
